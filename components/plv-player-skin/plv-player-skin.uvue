<template>
  <view class="skin">
    <view class="hit-area" @click="toggleControls"></view>
    <view v-if="visible && !locked" class="top-bar" :style="'padding-left:' + sideInset + 'px;padding-right:' + sideInset + 'px'">
      <view class="icon-button" @click="$emit('back')"><view class="back-icon"></view></view>
      <text class="title">{{ title }}</text>
      <view class="icon-button" @click="toggleMenu"><text class="more-icon">•••</text></view>
    </view>
    <view v-if="message.length > 0 && !locked" class="message" @click="$emit('retry')">
      <text class="message-text">{{ message }}</text>
    </view>
    <view v-if="fullscreen && visible" class="lock-button" :style="'left:' + sideInset + 'px'" @click="toggleLock">
      <view class="lock-head" :class="locked ? '' : 'lock-open'"></view><view class="lock-body"></view>
    </view>
    <view v-if="visible && !locked" class="bottom-bar" :style="bottomStyle">
      <slider class="timeline" :value="sliderValue" :disabled="!controllable || duration <= 0" :min="0" :max="1000" :step="1" :block-size="8" block-color="#ffffff" active-color="#ffffff" background-color="#686868" @changing="scrub" @change="seek" @touchcancel="cancelScrub" />
      <view class="controls-row">
        <view class="icon-button" @click="play"><view v-if="playing" class="pause-icon"><view class="pause-line"></view><view class="pause-line"></view></view><text v-else class="play-icon">▶</text></view>
        <text class="clock">{{ time(scrubbing ? scrubPosition : position) }} / {{ time(duration) }}</text>
        <view v-if="fullscreen && canSpeed" class="rate-button" @click="$emit('speed')"><text class="rate">{{ speed.toFixed(1) }} X</text></view>
        <view class="icon-button" @click="$emit('fullscreen')"><view class="fullscreen-icon"><view class="fullscreen-cut"></view></view></view>
      </view>
    </view>
    <view v-if="menuOpen && visible && !locked" class="menu" :style="'right:' + sideInset + 'px'">
      <text class="menu-heading">播放设置</text>
      <view v-if="canSpeed" class="menu-item" @click="$emit('speed')"><text class="menu-text">播放速度</text><text class="menu-value">{{ speed.toFixed(2) }}×</text></view>
      <view v-if="canQuality" class="menu-item" @click="$emit('quality')"><text class="menu-text">清晰度</text><text class="menu-value">{{ quality }}</text></view>
      <view v-if="allowDownload" class="menu-item" @click="download"><text class="menu-text">下载当前视频</text><text class="menu-value">↓</text></view>
      <view v-if="!canSpeed && !canQuality && !allowDownload" class="menu-item"><text class="menu-text">暂无可用设置</text></view>
    </view>
  </view>
</template>

<script lang="uts">
export default {
  name: 'PlvPlayerSkin',
  props: {
    title: {type: String, default: ''}, playing: {type: Boolean, default: false},
    position: {type: Number, default: 0}, duration: {type: Number, default: 0},
    fullscreen: {type: Boolean, default: false}, controllable: {type: Boolean, default: false},
    message: {type: String, default: ''}, speed: {type: Number, default: 1},
    quality: {type: String, default: '自动'}, canSpeed: {type: Boolean, default: false},
    canQuality: {type: Boolean, default: false}, allowDownload: {type: Boolean, default: true},
    bottomInset: {type: Number, default: 0}, sideInset: {type: Number, default: 12}
  },
  emits: ['back', 'play', 'seek', 'speed', 'quality', 'download', 'fullscreen', 'retry'],
  data() { return {visible: true, locked: false, menuOpen: false, scrubbing: false, scrubPosition: 0.0, hideTimer: 0} },
  computed: {
    sliderValue(): number { return this.duration > 0 ? Math.round(1000 * Math.min(1, Math.max(0, (this.scrubbing ? this.scrubPosition : this.position) / this.duration))) : 0 },
    bottomStyle(): string { return 'bottom:' + this.bottomInset + 'px;left:' + this.sideInset + 'px;right:' + this.sideInset + 'px' }
  },
  watch: {
    playing(_value: boolean) { this.showControls() },
    fullscreen(_value: boolean) { this.locked = false; this.menuOpen = false; this.showControls() },
    title(_value: string) { this.locked = false; this.menuOpen = false; this.scrubbing = false; this.showControls() }
  },
  beforeUnmount() { this.clearTimer() },
  methods: {
    clearTimer() { if (this.hideTimer != 0) clearTimeout(this.hideTimer); this.hideTimer = 0 },
    showControls() {
      this.visible = true; this.clearTimer()
      if (this.playing && !this.menuOpen && !this.scrubbing) this.hideTimer = setTimeout(() => { this.visible = false; this.hideTimer = 0 }, 4000)
    },
    toggleControls() { if (this.visible) { this.clearTimer(); this.visible = false; this.menuOpen = false } else this.showControls() },
    toggleMenu() { this.menuOpen = !this.menuOpen; this.showControls() },
    toggleLock() { this.locked = !this.locked; this.menuOpen = false; this.showControls() },
    play() { this.$emit('play'); this.showControls() },
    scrub(event: UniSliderChangeEvent) { this.clearTimer(); this.scrubbing = true; this.scrubPosition = this.duration * event.detail.value / 1000 },
    seek(event: UniSliderChangeEvent) { this.scrubbing = false; if (this.controllable) this.$emit('seek', this.duration * event.detail.value / 1000); this.showControls() },
    cancelScrub() { this.scrubbing = false; this.showControls() },
    download() { this.menuOpen = false; this.$emit('download'); this.showControls() },
    time(seconds: number): string {
      const total = Math.floor(Math.max(0, seconds)); const mins = Math.floor(total / 60); const secs = total % 60
      return (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs
    }
  }
}
</script>

<style>
.skin { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.hit-area { position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
.top-bar { position: absolute; top: 0; left: 0; right: 0; height: 52px; flex-direction: row; align-items: center; background-color: rgba(0,0,0,0.25); }
.icon-button { width: 42px; height: 44px; justify-content: center; align-items: center; }
.back-icon { width: 13px; height: 13px; border-left: 2px solid #ffffff; border-bottom: 2px solid #ffffff; transform: rotate(45deg); }
.title { lines: 1; white-space: nowrap; flex: 1; color: #ffffff; font-size: 16px; margin-left: 2px; text-overflow: ellipsis; }
.more-icon { color: #ffffff; font-size: 20px; letter-spacing: 2px; }
.bottom-bar { position: absolute; padding-top: 8px; }
.timeline { margin: 0; height: 24px; }
.controls-row { flex-direction: row; align-items: center; height: 48px; }
.clock { flex: 1; color: #ffffff; font-size: 13px; margin-left: 4px; }
.pause-icon { width: 13px; height: 18px; flex-direction: row; justify-content: space-between; }
.pause-line { width: 2px; height: 18px; background-color: #ffffff; }
.play-icon { font-size: 20px; color: #ffffff; }
.fullscreen-icon { width: 18px; height: 16px; border: 2px solid #ffffff; border-radius: 2px; justify-content: center; }
.fullscreen-cut { height: 5px; width: 24px; margin-left: -5px; background-color: #333333; }
.rate-button { padding: 12px; }
.rate { color: #ffffff; font-size: 15px; }
.message { position: absolute; top: 42%; left: 45px; right: 45px; align-items: center; }
.message-text { color: #ffffff; font-size: 13px; padding: 8px; border-radius: 4px; background-color: rgba(0,0,0,0.6); text-align: center; }
.lock-button { position: absolute; top: 43%; width: 44px; height: 48px; align-items: center; justify-content: center; }
.lock-head { width: 12px; height: 12px; border: 2px solid #ffffff; border-bottom-width: 0; border-top-left-radius: 7px; border-top-right-radius: 7px; }
.lock-open { transform: translateX(4px); }
.lock-body { width: 18px; height: 14px; border: 2px solid #ffffff; border-radius: 2px; }
.menu { position: absolute; top: 48px; width: 215px; padding: 16px; border-radius: 8px; background-color: rgba(18,29,42,0.96); }
.menu-heading { font-size: 12px; color: #9da9b7; margin-bottom: 8px; }
.menu-item { min-height: 40px; flex-direction: row; align-items: center; }
.menu-text { flex: 1; font-size: 14px; color: #ffffff; }
.menu-value { font-size: 13px; color: #93b7ff; }
</style>
