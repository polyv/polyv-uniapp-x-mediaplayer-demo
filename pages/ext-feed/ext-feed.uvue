<template>
  <view class="page">
    <view class="feed-stage" :style="stageStyle" @touchstart="onItemTouchStart" @touchmove.stop.prevent="onItemTouchMove" @touchend="onItemTouchEnd" @touchcancel="onItemTouchEnd">
      <view class="feed-track" :style="trackStyle">
        <view v-for="slot in feedSlots" :key="slot.index" class="feed-item" :style="cellStyle">
          <view class="video-area">
            <!-- #ifdef APP-ANDROID || APP-HARMONY || APP-IOS -->
            <plv-player
              v-if="slot.index == k && mountId.length > 0"
