    { vid: 'e97dbe3e641b079d268330cc274fe3b4_e', cover: 'https://img.videocc.net/uimage/e/e97dbe3e64/4/e97dbe3e641b079d268330cc274fe3b4_0.jpg!l1280Q85', title: '20211214 MR直播精彩回放【视频号】(1)', tags: ['企业', '精选'], desc: '保利威视频号内容精选，涵盖直播、发布会与产品演示等场景。', likeCount: 144, collectCount: 68, commentCount: 28, liked: false, collected: false },
    { vid: 'e97dbe3e643cd26d48aa46f5de150783_e', cover: 'https://img.videocc.net/uimage/e/e97dbe3e64/3/e97dbe3e643cd26d48aa46f5de150783_0.jpg!l1280Q85', title: '20210309 企业直播互动5大玩法【视频号】', tags: ['企业', '精选'], desc: '保利威视频号内容精选，涵盖直播、发布会与产品演示等场景。', likeCount: 181, collectCount: 81, commentCount: 29, liked: false, collected: false }
  ]

  export default {
    data() {
      return {
        dataList: feedTemplates as PlvFeedItem[],
        k: 0,                      // 当前 cell 下标（feed 核心 state）
        dragY: 0,                  // 跟手位移（px，上滑为负）
        animating: false,          // 松手后吸附动画中（此期间 transition 生效）
        settling: false,           // 吸附未结束，忽略新手势
        frameReadyIndex: -1,      // 收到当前视频首帧前始终保留封面
        // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
        feedSettings: {autoPlay: false} as PlvSessionSettingsPatch,
        feedEpoch: 0,
        currentId: '',
        currentIndex: -1,
        currentGeneration: -1,
        currentFrame: false,
        promotedAwaitingFrame: false,
        candidateId: '',
        candidateIndex: -1,
        candidateGeneration: -1,
        candidatePrepared: -1,
        candidateFrame: -1,
        candidateListener: '',
        mountId: '',
        hostReady: false,
        promoting: false,
        mediaPending: false,
        creatingFeedSession: false,
        // #endif
        cellHeight: 700,
        statusBarHeight: 20,
        bottomInset: 0,            // 底部系统导航栏 inset（三键导航/手势条），全屏布局用
        refreshing: false,
        loading: false,
        userPaused: false,
        pageVisible: true,
        expandedIndex: -1,
        progressPercent: 0.0,
        playHint: '',
      }
    },
    computed: {
      feedSlots() : PlvFeedSlot[] {
        const slots : PlvFeedSlot[] = []
        for (let index = this.k - 1; index <= this.k + 1; index++) {
          const itemIndex = Math.max(0, Math.min(this.dataList.length - 1, index))
          slots.push({ index: index, item: this.dataList[itemIndex] } as PlvFeedSlot)
        }
        return slots
      },
      // 视口只露一页；轨道恒定三槽（上一条 / 当前 / 下一条），当前槽居中
      stageStyle() : string {
        return 'height:' + this.cellHeight + 'px;'
      },
      cellStyle() : string {
        return 'height:' + this.cellHeight + 'px;'
      },
      // 贴底 UI 随 bottomInset 抬升，避免被系统导航栏（三键/手势条）遮挡
      scrmStyle() : string {
        return 'bottom:' + this.bottomInset + 'px;'
      },
      ctaStyle() : string {
        return 'bottom:' + this.bottomInset + 'px;'
      },
      infoStyle() : string {
        return 'bottom:' + (74 + this.bottomInset) + 'px;'
      },
      sideStyle() : string {
        return 'bottom:' + (160 + this.bottomInset) + 'px;'
      },
      trackStyle() : string {
        const y = -this.cellHeight + this.dragY
        const dur = this.animating ? SLIDE_MS : 0
        return 'transform:translateY(' + y + 'px);transition-property:transform;transition-duration:' + dur + 'ms;transition-timing-function:ease-out;'
      }
    },
    watch: {
      // feed 核心：k 变化 → 旧项停播、新项起播、守护重置
      k(newK : number, oldK : number) {
        if (newK === oldK) return
        // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
        this.selectFeedIndex(newK)
        // #endif
      }
    },
    onLoad() {
      plvTestLog('[FEED] onLoad enter')
      this.updateLayout()
      const bizBase = plvBizBaseUrl()
      plvTestLog('[FEED] bizBase=' + bizBase)
      if (bizBase.length > 0) {
        const vids : string[] = []
        for (let i = 0; i < this.dataList.length; i++) {
          vids.push(this.dataList[i].vid)
        }
        const self = this
        plvWarmPlayTokens(vids, this.viewerForBiz(), function (count : number, err : string) {
          plvTestLog('[FEED] warm tokens=' + count + ' err=' + err)
          if (err.length > 0) {
            self.playHint = err
          }
        })
      } else if (this.storedToken().length === 0) {
        this.playHint = '请配置业务服务地址，或手动保存播放 token'
        uni.showToast({ title: this.playHint, icon: 'none' })
      }
    },
    onReady() {
      // navigateTo 时 onLoad 可能仍拿到上一页（带导航栏）的窗口尺寸。
      this.updateLayout()
    },
    onResize() {
      this.updateLayout()
    },
    onHide() {
      this.pageVisible = false
      // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
      this.feedEpoch++
      this.mediaPending = false
      this.releaseFeedCandidate()
      if (this.currentId.length > 0 && this.currentGeneration > 0) {
        plvPlayerPause({sessionId: this.currentId, expectedMediaGeneration: this.currentGeneration})
      }
      // #endif
    },
    onShow() {
      this.pageVisible = true
      // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
      this.ensureFeedCurrent()
      // #endif
    },
    onUnload() {
      this.pageVisible = false
      gAnimToken = 0
      gTouchStartTime = 0
      // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
      this.feedEpoch++
      this.releaseFeedCandidate()
      this.releaseFeedCurrent()
      // #endif
    },
    methods: {
      storedText(key : string) : string {
        const value = uni.getStorageSync(key)
        if (value == null) {
          return ''
        }
        return '' + value
      },
      storedToken() : string {
        return this.storedText('plv_play_token')
      },
      storedViewerId() : string {
        return this.storedText('plv_play_viewer_id')
      },
      viewerForBiz() : string {
        return plvViewerIdOrDefault(this.storedViewerId())
      },
      updateLayout() {
        const win = uni.getWindowInfo()
        this.statusBarHeight = win.statusBarHeight > 0 ? win.statusBarHeight : 20
        // 全屏布局：窗口本身全屏（含底部导航栏区域），但 windowHeight 只报可用区高，
        // 且本机 runtime 的 safeAreaInsets.bottom 恒为 0（2026-11-05 真机实测：白条 ~100px）。
        // 故用 screenHeight（整屏高）作 cell 高度铺满屏底；贴底 UI 以 (screenHeight - windowHeight) 内缩避让导航键。
        const fullH = win.screenHeight > 0 ? win.screenHeight : (win.windowHeight > 0 ? win.windowHeight : 700)
        const usableH = win.windowHeight > 0 ? win.windowHeight : fullH
        this.cellHeight = fullH
        // iOS 沉浸式窗口包含 Home 指示条，需同时保留系统返回的安全区。
        this.bottomInset = Math.max(win.safeAreaInsets.bottom, Math.max(0, fullH - usableH))
        plvTestLog('[FEED] layout height=' + this.cellHeight + ' bottom=' + this.bottomInset)
      },

      // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
      ownsFeedTarget(epoch: number, index: number): boolean {
        return this.pageVisible && this.feedEpoch == epoch && this.k == index
      },
      releaseFeedCandidate() {
        const id = this.candidateId
        this.candidateId = ''
        this.candidateIndex = -1
        this.candidateGeneration = -1
        this.candidatePrepared = -1
        this.candidateFrame = -1
        this.promoting = false
        if (this.candidateListener.length > 0) {
          plvPlayerUnsubscribe({listenerId: this.candidateListener})
          this.candidateListener = ''
        }
        if (id.length > 0) {
          if (this.mountId == id) {
            this.mountId = ''
            this.hostReady = false
          }
          plvPlayerDestroySession({sessionId: id})
        }
      },
      releaseFeedCurrent() {
        const id = this.currentId
        this.currentId = ''
        this.currentIndex = -1
        this.currentGeneration = -1
        this.currentFrame = false
        this.promotedAwaitingFrame = false
        if (id.length == 0) return
        if (this.mountId == id) {
          this.mountId = ''
          this.hostReady = false
        }
        plvPlayerDestroySession({sessionId: id})
      },
      selectFeedIndex(index: number) {
        this.feedEpoch++
        this.mediaPending = false
        this.loading = true
        this.userPaused = false
        this.frameReadyIndex = -1
        this.progressPercent = 0
        this.playHint = ''
        if (!this.pageVisible) return
        if (!this.promoting && this.currentId.length > 0 && this.candidateIndex == index &&
            this.candidateGeneration > 0 && this.candidateGeneration == this.candidatePrepared) {
          this.promoteFeedCandidate(index)
          return
        }
        this.releaseFeedCandidate()
        this.releaseFeedCurrent()
        this.ensureFeedCurrent()
      },
      ensureFeedCurrent() {
        if (!this.pageVisible || this.creatingFeedSession || this.promoting) return
        const index = this.k
        if (this.currentId.length > 0 && this.currentIndex != index) this.releaseFeedCurrent()
        if (this.currentId.length > 0) {
          if (!this.hostReady || this.userPaused) return
          if (this.currentGeneration < 0) this.loadFeedCurrent()
          else this.startFeedCurrent()
          return
        }
        const epoch = this.feedEpoch
        this.creatingFeedSession = true
        plvPlayerCreateSession({
          settings: this.feedSettings,
          success: (result: PlvCreateSessionSuccess) => {
            this.creatingFeedSession = false
            if (!this.ownsFeedTarget(epoch, index)) {
              plvPlayerDestroySession({sessionId: result.sessionId})
              this.ensureFeedCurrent()
              return
            }
            this.currentId = result.sessionId
            this.currentIndex = index
            this.hostReady = false
            this.mountId = result.sessionId
          },
          fail: (error: PlvMediaPlayerFail) => {
            this.creatingFeedSession = false
            if (this.ownsFeedTarget(epoch, index)) this.showFeedFailure(error.errMsg)
            else this.ensureFeedCurrent()
          }
        })
      },
      loadFeedCurrent() {
        if (this.mediaPending || this.userPaused || !this.hostReady || !this.pageVisible) return
        const index = this.k
        const id = this.currentId
        const epoch = this.feedEpoch
        this.mediaPending = true
        this.loading = true
        this.requestFeedMedia(index, epoch, (source: PlvMediaSource | null, error: string) => {
          if (source == null) {
            this.mediaPending = false
            this.showFeedFailure(error)
            return
          }
          this.currentFrame = false
          plvPlayerSetMedia({
            sessionId: id, source: source,
            success: (result: PlvSessionSuccess) => {
              if (!this.ownsFeedTarget(epoch, index) || this.currentId != id) return
              this.mediaPending = false
              this.currentGeneration = result.mediaGeneration
              this.startFeedCurrent()
            },
            fail: (failure: PlvMediaPlayerFail) => {
              if (!this.ownsFeedTarget(epoch, index)) return
              this.mediaPending = false
              this.showFeedFailure(failure.errMsg)
            }
          })
        })
      },
      requestFeedMedia(index: number, epoch: number, done: (source: PlvMediaSource | null, error: string) => void) {
        const currentIndex = this.k
        const vid = this.dataList[index].vid
        const viewerId = this.viewerForBiz()
        const base = plvBizBaseUrl()
        plvEnsurePlayToken(vid, viewerId, (token: string, error: string, _encoded: string) => {
          if (!this.ownsFeedTarget(epoch, currentIndex)) return
          if (this.dataList[index].vid != vid || this.viewerForBiz() != viewerId || plvBizBaseUrl() != base) {
            done(null, '播放凭证配置已更改')
            return
          }
          if (token.length == 0) {
            done(null, error.length > 0 ? error : '该视频没有播放 token')
            return
          }
          const viewer: PlvViewerPatch = {viewerId: viewerId}
          const source: PlvMediaSource = {kind: 'vid', vid: vid, token: token, viewer: viewer}
          done(source, '')
        })
      },
      startFeedCurrent() {
        if (!this.pageVisible || this.userPaused || this.currentGeneration < 0 || !this.hostReady) return
        const id = this.currentId
        const index = this.k
        const epoch = this.feedEpoch
        plvPlayerStart({
          sessionId: id, expectedMediaGeneration: this.currentGeneration,
          success: (_result: PlvSessionSuccess) => {
            if (this.ownsFeedTarget(epoch, index) && this.currentId == id) this.prepareFeedNext()
          },
          fail: (error: PlvMediaPlayerFail) => {
            if (this.ownsFeedTarget(epoch, index) && this.currentId == id) this.showFeedFailure(error.errMsg)
          }
        })
      },
      prepareFeedNext() {
        const index = this.k
        const next = index + 1
        if (next >= this.dataList.length || this.candidateIndex >= 0 || this.creatingFeedSession) return
        const epoch = this.feedEpoch
        this.candidateIndex = next
        this.requestFeedMedia(next, epoch, (source: PlvMediaSource | null, _error: string) => {
          if (source == null) {
            this.releaseFeedCandidate()
            return
          }
          this.creatingFeedSession = true
          plvPlayerCreateSession({
            settings: this.feedSettings,
            success: (result: PlvCreateSessionSuccess) => {
              this.creatingFeedSession = false
              if (!this.ownsFeedTarget(epoch, index) || this.candidateIndex != next) {
                plvPlayerDestroySession({sessionId: result.sessionId})
                this.ensureFeedCurrent()
                return
              }
              this.candidateId = result.sessionId
              this.observeFeedCandidate(result.sessionId, source)
            },
            fail: (_failure: PlvMediaPlayerFail) => {
              this.creatingFeedSession = false
              if (this.ownsFeedTarget(epoch, index)) this.releaseFeedCandidate()
              else this.ensureFeedCurrent()
            }
          })
        })
      },
      observeFeedCandidate(id: string, source: PlvMediaSource) {
        plvPlayerSubscribe({
          sessionId: id, events: ['play-status', 'play-error', 'first-frame'],
          onEvent: (event: PlvPlayerEvent) => {
            if (event.sessionId != this.candidateId) return
            if (event.type == 'first-frame') this.candidateFrame = event.mediaGeneration
            if (event.type == 'play-status' && event.detail.status == 'prepared') {
              this.candidatePrepared = event.mediaGeneration
              plvTestLog('[FEED] typed prepared index=' + this.candidateIndex)
            }
            if (event.type == 'play-error' && !this.promoting) this.releaseFeedCandidate()
          },
          success: (receipt: PlvSubscribeSuccess) => {
            if (id != this.candidateId) {
              plvPlayerUnsubscribe({listenerId: receipt.listenerId})
              return
            }
            this.candidateListener = receipt.listenerId
            plvPlayerPrepareMedia({
              sessionId: id, source: source, expectedMediaGeneration: receipt.mediaGeneration,
              success: (result: PlvSessionSuccess) => {
                if (id == this.candidateId) this.candidateGeneration = result.mediaGeneration
              },
              fail: (_failure: PlvMediaPlayerFail) => {
                if (id == this.candidateId) this.releaseFeedCandidate()
              }
            })
          },
          fail: (_failure: PlvMediaPlayerFail) => {
            if (id == this.candidateId) this.releaseFeedCandidate()
          }
        })
      },
      promoteFeedCandidate(index: number) {
        const id = this.candidateId
        const previous = this.currentId
        const epoch = this.feedEpoch
        this.promoting = true
        this.hostReady = false
        plvPlayerPromotePrepared({
          sessionId: id, previousSessionId: previous, mediaGeneration: this.candidateGeneration,
          success: (result: PlvSessionSuccess) => {
            if (!this.ownsFeedTarget(epoch, index) || id != this.candidateId) return
            this.releaseFeedCurrent()
            this.currentId = id
            this.currentIndex = index
            this.currentGeneration = result.mediaGeneration
            this.currentFrame = this.candidateFrame == result.mediaGeneration
            this.promotedAwaitingFrame = true
            // Transfer the page's candidate ownership to current before clearing the old role.
            this.candidateId = ''
            this.releaseFeedCandidate()
            plvTestLog('[FEED] typed promoted index=' + index)
            this.prepareFeedNext()
          },
          fail: (_failure: PlvMediaPlayerFail) => {
            if (!this.ownsFeedTarget(epoch, index) || id != this.candidateId) return
            this.fallbackFeedPromotion()
          }
        })
        this.mountId = id
      },
      fallbackFeedPromotion() {
        this.feedEpoch++
        this.releaseFeedCandidate()
        this.releaseFeedCurrent()
        this.frameReadyIndex = -1
        plvTestLog('[FEED] typed fallback index=' + this.k)
        this.ensureFeedCurrent()
      },
      onFeedView(event: PlvPlayerEvent) {
        if (event.sessionId != this.mountId) return
        this.hostReady = true
        if (!this.promoting && this.currentGeneration < 0) this.loadFeedCurrent()
      },
      onFeedBindError(error: PlvMediaPlayerFail) {
        if (!this.pageVisible) return
        if (this.promoting) {
          this.fallbackFeedPromotion()
          return
        }
        this.releaseFeedCurrent()
        this.showFeedFailure(error.errMsg)
      },
      onFeedEvent(event: PlvPlayerEvent) {
        if (!this.pageVisible || event.sessionId != this.mountId) return
        const index = this.k
        if (this.promoting) {
          if (event.type == 'play-error') this.fallbackFeedPromotion()
          return
        }
        if (event.sessionId != this.currentId || event.mediaGeneration != this.currentGeneration) return
        if (event.type == 'first-frame') {
          this.currentFrame = true
        } else if (event.type == 'play-error') {
          if (this.promotedAwaitingFrame) this.fallbackFeedPromotion()
          else this.showFeedFailure(event.detail.error?.errMsg ?? '播放失败')
        } else if (event.type == 'position-change') {
          const position = event.detail.currentPosition ?? 0
          const duration = event.detail.duration ?? 0
          if (duration > 0) this.progressPercent = Math.min(1, position / duration)
          if (position > 0) plvTestLog('[FEED] position index=' + index + ' pos=' + position)
          if (this.hostReady && this.currentFrame && position > 0 && this.frameReadyIndex != index) {
            this.frameReadyIndex = index
            this.promotedAwaitingFrame = false
            this.loading = false
            plvTestLog('[FEED] cover-hidden first-frame index=' + index)
          }
        } else if (event.type == 'play-status' && event.detail.status == 'completed' && !this.userPaused) {
          const epoch = this.feedEpoch
          const id = event.sessionId
          plvPlayerSeekTo({
            sessionId: id, expectedMediaGeneration: event.mediaGeneration, seconds: 0,
            success: (_result: PlvSeekSuccess) => {
              if (this.ownsFeedTarget(epoch, index) && this.currentId == id) this.startFeedCurrent()
            },
            fail: (failure: PlvMediaPlayerFail) => {
              if (this.ownsFeedTarget(epoch, index)) this.showFeedFailure(failure.errMsg)
            }
          })
        }
      },
      showFeedFailure(message: string) {
        this.loading = false
        this.playHint = message
      },
      // #endif


      // ================= 跟手翻页：拖动时画面跟随，松手只吸附相邻一页 =================
      onItemTouchStart(e : any) {
        if (this.settling) return
        const ev = e as UniTouchEvent
        const t = ev.changedTouches[0]
        gTouchStartX = t.clientX
        gTouchStartY = t.clientY
        gTouchStartTime = Date.now()
        gAxis = 0
        this.animating = false
      },

      onItemTouchMove(e : any) {
        if (gTouchStartTime === 0 || this.settling) return
        const ev = e as UniTouchEvent
        const t = ev.changedTouches[0]
        const dx = t.clientX - gTouchStartX
        const dy = t.clientY - gTouchStartY
        if (gAxis === 0) {
          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return
          gAxis = Math.abs(dy) >= Math.abs(dx) ? 1 : 2
        }
        if (gAxis !== 1) return
        this.dragY = this.clampDrag(dy)
      },

      onItemTouchEnd(e : any) {
        if (gTouchStartTime === 0 || this.settling) return
        const ev = e as UniTouchEvent
        const t = ev.changedTouches[0]
        const dx = t.clientX - gTouchStartX
        const dy = t.clientY - gTouchStartY
        const dt = Math.max(1, Date.now() - gTouchStartTime)
        gTouchStartTime = 0
        const adx = Math.abs(dx)
        const ady = Math.abs(dy)
        if (gAxis === 0) {
          if (adx < TAP_SLOP && ady < TAP_SLOP && dt < 280) {
            this.togglePlay(this.k)
            return
          }
          if (ady > adx && ady >= 24) {
            gAxis = 1
          } else {
            this.springBack()
            return
          }
        }
        if (gAxis !== 1) {
          this.springBack()
          return
        }
        const velocity = ady / dt
        const flip = ady > this.cellHeight * 0.16 || (velocity > 0.5 && ady > 30)
        if (!flip) {
          this.springBack()
          return
        }
        if (dy < 0) {
          if (this.k >= this.dataList.length - 1) {
            uni.showToast({ title: '没有更多了', icon: 'none' })
            this.springBack()
            return
          }
          this.settleTo(this.k + 1)
        } else {
          if (this.k <= 0) {
            this.pullRefresh()
            this.springBack()
            return
          }
          this.settleTo(this.k - 1)
        }
      },

      // 两端橡皮筋，中间最多跟手一页，避免一次滑过多条
      clampDrag(dy : number) : number {
        const h = this.cellHeight
        if (dy > 0 && this.k <= 0) {
          return Math.min(dy * 0.32, h * 0.4)
        }
        if (dy < 0 && this.k >= this.dataList.length - 1) {
          return Math.max(dy * 0.32, -h * 0.4)
        }
        if (dy > h) return h
        if (dy < -h) return -h
        return dy
      },

      // 先打开 transition，下一帧再改目标位移，避免起止状态被合成到同一帧导致动画丢失
      animateDragTo(target : number, page : number) {
        this.settling = true
        this.animating = true
        const token = Date.now()
        gAnimToken = token
        const self = this
        setTimeout(() => {
          if (gAnimToken !== token) return
          self.dragY = target
          setTimeout(() => {
            if (gAnimToken !== token) return
            self.animating = false
            if (page >= 0) {
              self.dragY = 0
              self.k = page
            }
            self.settling = false
          }, SLIDE_MS + 40)
        }, 16)
      },

      settleTo(page : number) {
        if (page < 0 || page >= this.dataList.length || page === this.k) {
          this.springBack()
          return
        }
        const target = page > this.k ? -this.cellHeight : this.cellHeight
        this.animateDragTo(target, page)
      },

      springBack() {
        if (this.dragY === 0) return
        this.animateDragTo(0, -1)
      },

      // 首页下拉：只给反馈，不翻页
      pullRefresh() {
        if (this.refreshing) return
        this.refreshing = true
        uni.showToast({ title: '已刷新', icon: 'none' })
        setTimeout(() => {
          this.refreshing = false
        }, 800)
      },

      togglePlay(y : number) {
        if (y != this.k) return
        // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
        if (this.promoting) return
        if (this.currentGeneration < 0) {
          this.ensureFeedCurrent()
          return
        }
        this.userPaused = !this.userPaused
        if (this.userPaused) {
          plvPlayerPause({sessionId: this.currentId, expectedMediaGeneration: this.currentGeneration})
        } else {
          this.startFeedCurrent()
        }
        // #endif
      },

      // ================= 互动 / 跳转 =================
      goBack() {
        uni.navigateBack()
      },

      onLike(y : number) {
        const item = this.dataList[y]
        item.liked = !item.liked
        item.likeCount = item.likeCount + (item.liked ? 1 : -1)
      },

      onCollect(y : number) {
        const item = this.dataList[y]
        item.collected = !item.collected
        item.collectCount = item.collectCount + (item.collected ? 1 : -1)
      },

      toggleExpand(y : number) {
        this.expandedIndex = this.expandedIndex === y ? -1 : y
      },

      gotoPlayer(y : number) {
        const item = this.dataList[y]
        uni.navigateTo({ url: '/pages/player/player?vid=' + item.vid })
      },

      toastDemo(name : string) {
        uni.showToast({ title: name + '：演示页面，仅作展示', icon: 'none' })
      }
    }
  }
</script>

