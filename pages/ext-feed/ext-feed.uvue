                      </view>
                    </view>
                  </view>
                </view>
                <view class="desc-row">
                  <text class="desc-text" :class="expandedIndex === slot.index ? 'desc-text-full' : ''">{{ slot.item.desc }}</text>
                  <text class="expand-btn" @touchstart.stop @touchend.stop @click="toggleExpand(slot.index)">{{ expandedIndex === slot.index ? '收起' : '展开' }}</text>
                </view>
                <view class="disclaimer-row">
                  <text class="disclaimer-icon">ⓘ</text>
