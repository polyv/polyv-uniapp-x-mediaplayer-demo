                  <image class="disc-cover" :src="slot.item.cover" mode="aspectFill" />
                </view>
                <text class="disc-note">♪</text>
              </view>
            </view>
            <view class="info-bar" :style="infoStyle">
              <view class="info-content">
                <view class="info-top" @touchstart.stop @touchend.stop @click="gotoPlayer(slot.index)">
                  <image class="poster" :src="slot.item.cover" mode="aspectFill" />
                  <view class="info-right">
                    <view class="title-row">
                      <text class="title-text">{{ slot.item.title }}</text>
                      <text class="title-arrow">›</text>
                    </view>
                    <view class="tag-row">
                      <view class="tag-chip" v-for="(tag, tIndex) in slot.item.tags" :key="tIndex">
