              :session-id="mountId"
              :pause-on-detach="false"
              class="player"
              :style="'position:absolute;top:0;left:0;width:100%;height:100%;'"
              @view-init="onFeedView"
              @first-frame="onFeedEvent"
              @play-status="onFeedEvent"
              @play-error="onFeedEvent"
              @position-change="onFeedEvent"
              @session-error="onFeedBindError"
            />
            <!-- #endif -->
            <!-- 封面节点跟随视频保留；首帧显示之前不露出播放器的黑底。 -->
            <image v-if="slot.index >= 0 && slot.index < dataList.length"
              v-show="slot.index !== k || frameReadyIndex !== k"
              class="feed-cover" :src="slot.item.cover" mode="aspectFit" />
